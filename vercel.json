{
  "buildCommand": "npm test && node scripts/verify-integrations.js",
  "outputDirectory": "public",
  "regions": [
    "fra1"
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/dashboard"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/control.js": {
      "maxDuration": 120
    },
    "api/cron.js": {
      "maxDuration": 300
    },
    "api/research.js": {
      "maxDuration": 45
    }
  }
}
